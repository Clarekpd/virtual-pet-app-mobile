{
  "expo": {
    "name": "pet-app-research",
    "slug": "pet-app-research",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/pets/cat.png",
    "scheme": "petappresearch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/pets/cat.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.deepstatedino.petappresearch"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/pets/gecko.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/pets/gecko.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
